{
  "name": "plex-user-manager",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:web": "vite --config vite.config.ts --configLoader runner --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint server web tests scripts vite.config.ts",
    "test": "vitest run --configLoader runner",
    "build": "tsc -p tsconfig.build.json && vite build --configLoader runner",
    "start": "node dist/server/index.js",
    "worker": "node dist/server/worker.js",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "privacy": "node scripts/privacy-check.mjs",
    "backup": "node dist/server/backup.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "helmet": "8.3.0",
    "nodemailer": "10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "smtp-server": "3.19.21",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
