# Copy to an ignored .env outside the source checkout for deployment.
# Replace YOUR_DATA_DIRECTORY with an absolute host path before starting Compose.
# Contacts, consent, templates and schedules are configured in the app and persist in SQLite.
APP_IMAGE=plex-user-manager:local
# For a published release: ghcr.io/YOUR_IMAGE_OWNER/YOUR_REPOSITORY:VERSION
NODE_IMAGE=node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
PUBLIC_URL=https://plex-admin.example.com
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
# Leave empty for direct requests; otherwise specify only the actual proxy IP/CIDR.
TRUSTED_PROXY=
DATA_DIRECTORY=YOUR_DATA_DIRECTORY/data
ENCRYPTION_KEY_PATH=YOUR_DATA_DIRECTORY/secrets/encryption_key
BOOTSTRAP_SECRET_PATH=YOUR_DATA_DIRECTORY/secrets/bootstrap_secret
# Optional external worker, on a separate host:
WORKER_PORT=3001
WORKER_DATA_DIRECTORY=YOUR_DATA_DIRECTORY/worker-data
HEARTBEAT_KEY_PATH=YOUR_DATA_DIRECTORY/secrets/heartbeat_key
WORKER_CONFIG_PATH=YOUR_DATA_DIRECTORY/secrets/worker_config.json
